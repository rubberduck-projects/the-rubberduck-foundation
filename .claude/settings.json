{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "30000"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "Task",
      "TodoRead",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Edit",
      "MultiEdit",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git mv *)",
      "Bash(npm *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Edit(Dockerfile*)",
      "Edit(docker-compose*)",
      "Bash(docker *)",
      "Edit(package.json)",
      "Edit(**/package.json)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(npm publish *)",
      "Bash(npx -y *)",
      "Edit(.env.*)",
      "Edit(.git/**)",
      "Edit(.claude/settings.json)",
      "Edit(production.config.*)"
    ],
    "ask": [
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(tsconfig.json)",
      "Edit(tsconfig.*.json)",
      "Edit(.eslintrc*)",
      "Edit(.prettierrc*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "node ./.claude/status-line.js"
  },
  "plansDirectory": "./.claude/__local__/plans/",
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "./.claude/__local__/memory/",
  "agent": "frontend-engineer",
  "worktree": { "bgIsolation": "none" }
}
